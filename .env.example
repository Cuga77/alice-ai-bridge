# Скопируйте в .env и заполните. Переменные окружения процесса важнее значений из файла.

# Docker: какие сервисы запускать помимо моста (через запятую):
#   ollama — локальная модель, caddy — HTTPS на VPS с доменом. Пусто — только мост.
COMPOSE_PROFILES=ollama

# Профиль caddy: домен, A-запись которого указывает на сервер
# DOMAIN=alice.example.com

# ID навыка из Яндекс Диалогов: запросы от других навыков отклоняются (несколько — через запятую)
ALLOWED_SKILL_ID=

# Часовой пояс для даты и времени в ответах (Алиса часто присылает UTC)
TIMEZONE=Europe/Moscow

# Локальная Ollama (по умолчанию). В Docker адрес Ollama подставляется сам;
# LLM_BASE_URL задавайте только для другого сервера моделей.
LLM_MODEL=gemma3:1b

# Gemini вместо Ollama (тогда уберите ollama из COMPOSE_PROFILES)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_API_KEY=AIza...
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_REASONING_EFFORT=minimal
# LLM_MAX_TOKENS=1000
